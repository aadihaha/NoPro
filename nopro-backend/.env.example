# Server Configuration
PORT=5000

# Pinecone Vector DB
# IMPORTANT: Create your Pinecone index with dimension=768 (metric=cosine) to match Google's text-embedding-004
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=nopro-index

# Google Gemini API (used for free text-embedding-004 embeddings, 768 dimensions)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (LLM)
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
